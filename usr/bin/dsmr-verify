#!/bin/bash
# dsmr-verify — end-to-end verification of the DSMR qmail/vpopmail/dovecot stack.
# Run as root (or a user with sudo) on the installed system.
set -euo pipefail

PASS=0
FAIL=0

green='\033[0;32m'
red='\033[0;31m'
reset='\033[0m'

pass() { echo -e "${green}PASS${reset} $1"; PASS=$((PASS+1)); }
fail() { echo -e "${red}FAIL${reset} $1"; FAIL=$((FAIL+1)); }

check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
        pass "$label"
    else
        fail "$label"
    fi
}

# ── Test fixture management ────────────────────────────────────────────────
# These fixtures are created at startup if absent and destroyed at exit.
FIXTURE_DOMAIN=example.com
FIXTURE_VPASS=testpass123
FIXTURE_SYSUSER=marvin
FIXTURE_SYSPASS=marvinpass

_fx_domain=false
_fx_user=false
_fx_sysuser=false
_fx_marvin_passwd=false
_fx_marvin_assign=false

teardown_fixtures() {
    echo "--- Tearing down test fixtures ---"
    if [[ "$_fx_user" == true ]]; then
        sudo /home/vpopmail/bin/vdeluser "test@${FIXTURE_DOMAIN}" >/dev/null 2>&1 || true
    fi
    if [[ "$_fx_domain" == true ]]; then
        sudo /home/vpopmail/bin/vdeldomain "$FIXTURE_DOMAIN" >/dev/null 2>&1 || true
        sudo sed -i "/^+${FIXTURE_DOMAIN}-:/d" /var/lib/qmail/users/assign 2>/dev/null || true
    fi
    if [[ "$_fx_marvin_assign" == true ]]; then
        sudo sed -i "/^=example\\.com-${FIXTURE_SYSUSER}:/d" /var/lib/qmail/users/assign 2>/dev/null || true
    fi
    if [[ "$_fx_domain" == true || "$_fx_marvin_assign" == true ]]; then
        sudo /var/lib/qmail/bin/qmail-newu 2>/dev/null || true
        sudo svc -t /etc/service/qmail-send 2>/dev/null || true
    fi
    if [[ "$_fx_marvin_passwd" == true ]]; then
        sudo sed -i "/^${FIXTURE_SYSUSER}:{CRYPT}/d" /etc/dovecot/system-passwd 2>/dev/null || true
    fi
    if [[ "$_fx_sysuser" == true ]]; then
        sudo userdel -r "$FIXTURE_SYSUSER" >/dev/null 2>&1 || true
    fi
    if [[ "$_fx_marvin_passwd" == true || "$_fx_sysuser" == true ]]; then
        sudo doveadm reload >/dev/null 2>&1 || true
    fi
}
trap teardown_fixtures EXIT

setup_fixtures() {
    echo "--- Setting up test fixtures ---"
    local vpop_uid vpop_gid
    vpop_uid=$(id -u vpopmail 2>/dev/null || echo 89)
    vpop_gid=$(id -g vpopmail 2>/dev/null || echo 89)

    # vpopmail domain + users/assign wildcard
    if ! sudo /home/vpopmail/bin/vdominfo "$FIXTURE_DOMAIN" >/dev/null 2>&1; then
        sudo /home/vpopmail/bin/vadddomain "$FIXTURE_DOMAIN" postmaster123 >/dev/null 2>&1
        _fx_domain=true
        sudo sed -i "/^\\.$/i +${FIXTURE_DOMAIN}-:${FIXTURE_DOMAIN}:${vpop_uid}:${vpop_gid}:/home/vpopmail/domains/${FIXTURE_DOMAIN}/:-::" \
            /var/lib/qmail/users/assign
        sudo /var/lib/qmail/bin/qmail-newu
        # Restart qmail-send so it re-reads virtualdomains immediately
        sudo svc -t /etc/service/qmail-send
        sleep 2
    fi

    # vpopmail test user
    if ! sudo /home/vpopmail/bin/vuserinfo "test@${FIXTURE_DOMAIN}" >/dev/null 2>&1; then
        sudo /home/vpopmail/bin/vadduser "test@${FIXTURE_DOMAIN}" "$FIXTURE_VPASS" >/dev/null 2>&1
        _fx_user=true
    fi

    # system user marvin + Maildir
    if ! id "$FIXTURE_SYSUSER" >/dev/null 2>&1; then
        sudo useradd -m "$FIXTURE_SYSUSER" >/dev/null 2>&1
        sudo mkdir -p /home/${FIXTURE_SYSUSER}/Maildir/{new,cur,tmp}
        sudo chown -R ${FIXTURE_SYSUSER}:${FIXTURE_SYSUSER} /home/${FIXTURE_SYSUSER}/Maildir
        printf './Maildir/\n' | sudo tee /home/${FIXTURE_SYSUSER}/.qmail >/dev/null
        sudo chown ${FIXTURE_SYSUSER}:${FIXTURE_SYSUSER} /home/${FIXTURE_SYSUSER}/.qmail
        _fx_sysuser=true
    fi

    # marvin in dovecot system-passwd
    if ! sudo grep -q "^${FIXTURE_SYSUSER}:" /etc/dovecot/system-passwd 2>/dev/null; then
        local m_uid m_gid m_hash
        m_uid=$(id -u "$FIXTURE_SYSUSER")
        m_gid=$(id -g "$FIXTURE_SYSUSER")
        m_hash=$(openssl passwd -6 "$FIXTURE_SYSPASS")
        printf '%s:{CRYPT}%s:%s:%s::/home/%s:/bin/bash\n' \
            "$FIXTURE_SYSUSER" "$m_hash" "$m_uid" "$m_gid" "$FIXTURE_SYSUSER" \
            | sudo tee -a /etc/dovecot/system-passwd >/dev/null
        _fx_marvin_passwd=true
    fi

    # marvin exact-match in users/assign (before the +example.com- wildcard)
    if ! grep -q "^=example\\.com-${FIXTURE_SYSUSER}:" /var/lib/qmail/users/assign 2>/dev/null; then
        local m_uid m_gid
        m_uid=$(id -u "$FIXTURE_SYSUSER")
        m_gid=$(id -g "$FIXTURE_SYSUSER")
        sudo sed -i "/^+${FIXTURE_DOMAIN}-:/i =example.com-${FIXTURE_SYSUSER}:${FIXTURE_SYSUSER}:${m_uid}:${m_gid}:/home/${FIXTURE_SYSUSER}:::" \
            /var/lib/qmail/users/assign
        sudo /var/lib/qmail/bin/qmail-newu
        _fx_marvin_assign=true
    fi

    sudo doveadm reload >/dev/null 2>&1 || true
    echo
}

setup_fixtures

echo "=== DSMR Stack Verification ==="
echo "Date: $(date)"
echo

# ── 1. Package installation ────────────────────────────────────────────────
echo "--- Package installation ---"
for pkg in \
    fehqlibs-dev \
    libsrs2 \
    ucspi-ssl \
    qmail \
    qmail-uids-gids \
    vpopmail \
    dsmr-qmail-run \
    dovecot-core \
    dovecot-imapd \
    dovecot-pgsql \
    dovecot-vpopmail; do
    state=$(dpkg-query -W -f='${db:Status-Abbrev}' "$pkg" 2>/dev/null || echo "??")
    if [ "$state" = "ii " ]; then
        pass "$pkg installed"
    else
        fail "$pkg not fully installed (state: $state)"
    fi
done
check "dsmr-email-encabulator info file" test -f /usr/share/info/dsmr-email-encabulator.info.gz
echo

# ── 2. Service health ──────────────────────────────────────────────────────
echo "--- Service health ---"
check "daemontools-run active"     systemctl is-active --quiet daemontools-run
check "svscan running"             pgrep -x svscan
for svc in qmail-send qmail-smtpd qmail-submission; do
    check "$svc supervised"        svok /etc/service/$svc
done
if ss -tlnp | grep -q ':25 ';  then pass "qmail-smtpd listening (port 25)";         else fail "qmail-smtpd listening (port 25)";         fi
if ss -tlnp | grep -q ':587 '; then pass "qmail-submission listening (port 587)";    else fail "qmail-submission listening (port 587)";    fi
check "dovecot active"             systemctl is-active --quiet dovecot
if ss -tlnp | grep -q ':143 '; then pass "IMAP port 143 listening";                  else fail "IMAP port 143 listening";                  fi
if ss -tlnp | grep -q ':993 '; then pass "IMAPS port 993 listening";                 else fail "IMAPS port 993 listening";                 fi
echo

# ── 3. qmail control files ────────────────────────────────────────────────
echo "--- qmail control files ---"
CTRLDIR=/etc/qmail
check "qmailctl in PATH"          which qmailctl
check "me control file"           test -f "$CTRLDIR/me"
check "rcpthosts exists"          test -f "$CTRLDIR/rcpthosts"
check "tcp.smtp.cdb exists"       test -f "$CTRLDIR/tcp.smtp.cdb"
check "tcp.submission.cdb exists" test -f "$CTRLDIR/tcp.submission.cdb"
check "servercert.pem exists"     test -f "$CTRLDIR/servercert.pem"
if sudo stat -c '%G' "$CTRLDIR/servercert.pem" 2>/dev/null | grep -q '^vchkpw$'; then
    pass "servercert.pem group is vchkpw"
else
    fail "servercert.pem group is vchkpw (qmail<=1.06.3-4 set root:qmail, blocking submission STARTTLS)"
fi
check "DKIM key directory"        test -d "$CTRLDIR/domainkeys"
check "filterargs exists"         test -f "$CTRLDIR/filterargs"

# STARTTLS probe: verifies the cert is readable by the smtpd process
starttls_out=$(timeout 8 openssl s_client -connect localhost:587 \
    -starttls smtp 2>&1 </dev/null || true)
if echo "$starttls_out" | grep -q 'CONNECTED\|Verify return code'; then
    pass "STARTTLS port 587 TLS handshake completes"
else
    fail "STARTTLS port 587 TLS handshake completes"
    echo "$starttls_out" | grep -E 'error:|454|STARTTLS' | head -3 | sed 's/^/  /' || true
fi
echo

# ── 4. PostgreSQL / vpopmail database ────────────────────────────────────
echo "--- PostgreSQL / vpopmail database ---"
VPOP_PGSQL=/home/vpopmail/etc/vpopmail.pgsql
if sudo test -f "$VPOP_PGSQL"; then
    pass "vpopmail.pgsql exists"
    # vpopmail.pgsql format: host|port|user|password|database
    db_line=$(sudo cat "$VPOP_PGSQL")
    db_host=$(echo "$db_line" | cut -d'|' -f1)
    db_port=$(echo "$db_line" | cut -d'|' -f2)
    db_user=$(echo "$db_line" | cut -d'|' -f3)
    db_pass=$(echo "$db_line" | cut -d'|' -f4)
    db_name=$(echo "$db_line" | cut -d'|' -f5)

    # Verify field count and that port is numeric (catches swapped password/database)
    IFS='|' read -r -a _pgsql_fields <<< "$db_line"
    if [[ "${#_pgsql_fields[@]}" -eq 5 && "${_pgsql_fields[1]}" =~ ^[0-9]+$ ]]; then
        pass "vpopmail.pgsql field order (5 fields, numeric port)"
    else
        fail "vpopmail.pgsql field order (got ${#_pgsql_fields[@]} fields; expected host|port|user|password|database)"
    fi

    if PGPASSWORD="$db_pass" psql -h "$db_host" -p "$db_port" \
            -U "$db_user" -d "$db_name" \
            -c "SELECT COUNT(*) FROM vpopmail;" >/dev/null 2>&1; then
        pass "PostgreSQL SELECT on vpopmail table"
    else
        fail "PostgreSQL SELECT on vpopmail table"
    fi

    dc_count=$(PGPASSWORD="$db_pass" psql -h "$db_host" -p "$db_port" \
        -U "$db_user" -d "$db_name" -tAc \
        "SELECT COUNT(*) FROM dir_control;" 2>/dev/null || echo "0")
    if [[ "$dc_count" =~ ^[1-9] ]]; then
        pass "dir_control table populated ($dc_count domains)"
    else
        fail "dir_control table populated (count: ${dc_count:-0})"
    fi

    TEST_TABLE="dsmr_grant_test_$$"
    if PGPASSWORD="$db_pass" psql -h "$db_host" -p "$db_port" \
            -U "$db_user" -d "$db_name" \
            -c "CREATE TABLE $TEST_TABLE (id INT); DROP TABLE $TEST_TABLE;" \
            >/dev/null 2>&1; then
        pass "PostgreSQL CREATE/DROP privilege (vpopmail user)"
    else
        fail "PostgreSQL CREATE/DROP privilege (vpopmail user)"
    fi
else
    fail "vpopmail.pgsql missing"
    fail "vpopmail.pgsql field order (skipped)"
    fail "PostgreSQL SELECT on vpopmail table (skipped)"
    fail "dir_control table populated (skipped)"
    fail "PostgreSQL CREATE/DROP privilege (skipped)"
fi
echo

# ── 5. vpopmail domain and virtual user ──────────────────────────────────
echo "--- vpopmail virtual user (test@example.com) ---"
check "example.com domain exists" sudo /home/vpopmail/bin/vdominfo example.com
check "test@example.com exists"   sudo /home/vpopmail/bin/vuserinfo test@example.com

VTEST_DIR=$(sudo /home/vpopmail/bin/vuserinfo test@example.com 2>/dev/null \
            | grep '^dir:' | awk '{print $2}') || true
if [ -n "$VTEST_DIR" ] && sudo test -d "$VTEST_DIR/Maildir"; then
    pass "test@example.com Maildir exists"
else
    fail "test@example.com Maildir missing (dir: ${VTEST_DIR:-unset})"
fi

# Every vpopmail domain directory must have a wildcard entry in users/assign,
# otherwise qmail-lspawn cannot route inbound mail for that domain.
_dom_dirs=$(sudo ls /home/vpopmail/domains/ 2>/dev/null | grep -v '^\.' | wc -l)
_wildcard_ok=0
while IFS= read -r _dom; do
    grep -q "^+${_dom}-:" /var/lib/qmail/users/assign 2>/dev/null && \
        _wildcard_ok=$((_wildcard_ok+1))
done < <(sudo ls /home/vpopmail/domains/ 2>/dev/null | grep -v '^\.')
if [[ "$_wildcard_ok" -eq "$_dom_dirs" && "$_dom_dirs" -gt 0 ]]; then
    pass "users/assign wildcard coverage ($_wildcard_ok/$_dom_dirs vpopmail domains)"
else
    fail "users/assign wildcard coverage ($_wildcard_ok/$_dom_dirs vpopmail domains have +domain-: entries)"
fi
echo

# ── 6. System user (marvin@example.com) ──────────────────────────────────
echo "--- System user (marvin@example.com) ---"
check "Unix user marvin exists"             id marvin
check "marvin Maildir exists"               sudo test -d /home/marvin/Maildir/new
check "marvin .qmail exists"                sudo test -f /home/marvin/.qmail
check "system-passwd has marvin entry"      sudo grep -q '^marvin:' /etc/dovecot/system-passwd
check "users/assign has example.com-marvin" grep -q '^=example.com-marvin:' /var/lib/qmail/users/assign
echo

# ── 7. dovecot generated files ────────────────────────────────────────────
echo "--- dovecot generated files ---"
check "dovecot-vpopmail-sql.conf.ext exists" sudo test -f /etc/dovecot/dovecot-vpopmail-sql.conf.ext
if sudo grep -q 'sql_driver = pgsql' /etc/dovecot/dovecot-vpopmail-sql.conf.ext 2>/dev/null; then
    pass "dovecot SQL config uses pgsql driver"
else
    fail "dovecot SQL config uses pgsql driver"
fi
if sudo stat -c '%a %G' /etc/dovecot/dovecot-vpopmail-sql.conf.ext 2>/dev/null | grep -q '^640 dovecot'; then
    pass "dovecot-vpopmail-sql.conf.ext perms (640 root:dovecot)"
else
    fail "dovecot-vpopmail-sql.conf.ext perms (640 root:dovecot)"
fi
check "system-passwd exists"      sudo test -f /etc/dovecot/system-passwd
check "dovecot TLS cert exists"   sudo test -f /etc/dovecot/private/dovecot.pem
check "dovecot TLS key exists"    sudo test -f /etc/dovecot/private/dovecot.key
echo

# ── 8. doveadm auth test ──────────────────────────────────────────────────
echo "--- dovecot authentication ---"
if sudo doveadm auth test test@example.com testpass123 2>&1 | grep -q 'auth succeeded'; then
    pass "doveadm auth test@example.com (vpopmail PostgreSQL)"
else
    fail "doveadm auth test@example.com (vpopmail PostgreSQL)"
    sudo doveadm auth test test@example.com testpass123 2>&1 | sed 's/^/  /'
fi

if sudo doveadm auth test marvin@example.com marvinpass 2>&1 | grep -q 'auth succeeded'; then
    pass "doveadm auth marvin@example.com (passwd-file)"
else
    fail "doveadm auth marvin@example.com (passwd-file)"
    sudo doveadm auth test marvin@example.com marvinpass 2>&1 | sed 's/^/  /'
fi
echo

# ── 9. doveadm user lookup ────────────────────────────────────────────────
echo "--- dovecot user lookup ---"
if sudo doveadm user test@example.com 2>&1 | grep -q 'home'; then
    pass "doveadm user test@example.com"
    sudo doveadm user test@example.com 2>&1 | grep -E '(home|uid|gid)' | sed 's/^/  /'
else
    fail "doveadm user test@example.com"
fi

if sudo doveadm user marvin@example.com 2>&1 | grep -q 'home'; then
    pass "doveadm user marvin@example.com"
    sudo doveadm user marvin@example.com 2>&1 | grep -E '(home|uid|gid)' | sed 's/^/  /'
else
    fail "doveadm user marvin@example.com"
fi
echo

# ── 10. IMAPS login (port 993) ────────────────────────────────────────────
echo "--- IMAPS login (port 993) ---"
imap_test() {
    local user="$1" pass="$2" label="$3"
    local result
    result=$(
        (
          printf 'a LOGIN %s %s\r\n' "$user" "$pass"
          sleep 1
          printf 'b SELECT INBOX\r\n'
          sleep 1
          printf 'c LOGOUT\r\n'
          sleep 1
        ) | openssl s_client -connect localhost:993 -quiet 2>/dev/null
    )
    if echo "$result" | grep -q '^a OK'; then
        pass "$label LOGIN"
    else
        fail "$label LOGIN"
        echo "$result" | grep -E '^[a-c] ' | sed 's/^/  /'
    fi
    if echo "$result" | grep -q '^b OK'; then
        pass "$label SELECT INBOX"
    else
        fail "$label SELECT INBOX"
        echo "$result" | grep -E '^(b |\* )' | sed 's/^/  /'
    fi
}

imap_test "test@example.com"   "testpass123" "test@example.com"
imap_test "marvin@example.com" "marvinpass"  "marvin@example.com"
echo

# ── 11. Mail delivery ─────────────────────────────────────────────────────
echo "--- Mail delivery (qmail injection) ---"
deliver_test() {
    local to="$1" maildir="$2" label="$3"
    local before after msgid
    msgid="dsmr-verify-$$-$(date +%s)-${label//[^a-z]/}"
    before=$(sudo find "$maildir/new" -maxdepth 1 -type f 2>/dev/null | wc -l)
    printf 'From: verify@localhost\r\nTo: %s\r\nSubject: dsmr-verify %s\r\nMessage-ID: <%s>\r\n\r\ntest body\r\n' \
        "$to" "$label" "$msgid" \
        | sudo -u vpopmail /var/lib/qmail/bin/qmail-inject "$to" 2>&1
    sleep 3
    after=$(sudo find "$maildir/new" -maxdepth 1 -type f 2>/dev/null | wc -l)
    if [ "$after" -gt "$before" ]; then
        pass "$label delivery ($before → $after messages)"
    else
        fail "$label delivery ($before → $after messages)"
        sudo tail -5 /var/log/qmail/send/current 2>/dev/null | sed 's/^/  /' || true
    fi
}

VTEST_DIR=$(sudo /home/vpopmail/bin/vuserinfo test@example.com 2>/dev/null \
            | grep '^dir:' | awk '{print $2}') || true
deliver_test "test@example.com"   "${VTEST_DIR}/Maildir" "test@example.com"
deliver_test "marvin@example.com" "/home/marvin/Maildir"  "marvin@example.com"
echo

# ── Summary ───────────────────────────────────────────────────────────────
TOTAL=$((PASS+FAIL))
echo "=== Summary ==="
echo -e "Passed: ${green}${PASS}${reset} / ${TOTAL}  Failed: ${red}${FAIL}${reset}"
if [ "$FAIL" -eq 0 ]; then
    echo -e "${green}All ${TOTAL} checks passed.${reset}"
    exit 0
else
    echo -e "${red}${FAIL} of ${TOTAL} check(s) failed.${reset}"
    exit 1
fi
